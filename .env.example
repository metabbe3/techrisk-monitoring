LOGIN_EMAIL=your.email@dana.id
LOGIN_PASSWORD=secret

# Optional overrides
# HEADLESS=false              # watch the browser work
# LOGIN_URL=https://auth.paas.dana.id/#/cloudauth/login?goto=...
# PORT=8080                   # web server port (inside container)
# WEB_PORT=8787               # host port for docker compose web
# DATA_DIR=/var/lib/techrisk  # where runs+screenshots are stored (default ./output — never /tmp)
# RETENTION_RUNS=50           # keep newest N run dirs (0 = keep forever)
# CAPTURE_TABLE_TIMEOUT_MS=90000
# WEBHOOK_URL=https://hooks.slack.com/services/.../...   # alerts on P1/P2/CAPTURE FAILED
# API_TOKEN=change-me         # required for API/UI access when set
# CAPTURE_DAILY_AT=07:05      # in-server daily capture (no host cron needed)
# CAPTURE_ARGS=--modules all --from 2026-08-18 --to 2026-08-19
# TZ=Asia/Jakarta             # container timezone for the scheduler

# MySQL index of results (techrisk-dashboard DB) — optional, capture never
# depends on it; failed writes queue and retry on the next run.
# MYSQL_HOST=127.0.0.1        # unset = sink off. From containers: db / host gateway IP
# MYSQL_PORT=33061
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=laravel
# MYSQL_TABLE=incident_captures
